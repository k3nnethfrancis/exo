{
  "name": "stem",
  "private": true,
  "version": "0.1.0-alpha.3",
  "description": "Open-source knowledge-graph interface and Markdown editor for working alongside terminal agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.2.2 <12"
  },
  "scripts": {
    "dev": "STEM_WORKSPACE_ROOT=${STEM_WORKSPACE_ROOT:-$PWD} STEM_DEFAULT_TERMINAL_CWD=${STEM_DEFAULT_TERMINAL_CWD:-$PWD} pnpm --filter @stem/desktop dev",
    "dev:qa": "STEM_WORKSPACE_ROOT=${STEM_WORKSPACE_ROOT:-$PWD} STEM_RUNTIME_ROOT=${STEM_RUNTIME_ROOT:-$PWD/.stem-dev} STEM_USER_DATA_PATH=${STEM_USER_DATA_PATH:-$PWD/.stem-dev/user-data} STEM_DEFAULT_TERMINAL_CWD=${STEM_DEFAULT_TERMINAL_CWD:-$PWD} pnpm --filter @stem/desktop dev",
    "stem": "tsx packages/cli/src/index.ts",
    "install:local": "scripts/install-local",
    "install:mac-app": "scripts/install-mac-app",
    "ci:check": "pnpm check && ./scripts/install-local --dry-run --skip-install --skip-build",
    "terminal:check": "pnpm --filter @stem/desktop exec vitest run src/main/terminal/terminal-manager.test.ts src/renderer/src/components/terminalRegistry.test.ts src/renderer/src/components/terminalInputFilters.test.ts src/renderer/src/components/terminalOutputChunks.test.ts src/renderer/src/components/terminalPresentation.test.ts src/renderer/src/components/terminalFonts.test.ts src/renderer/src/terminalSessions.test.ts src/renderer/src/hooks/useTerminalSessions.test.ts src/renderer/src/components/terminalHydration.test.ts",
    "check": "pnpm check:unused && pnpm typecheck && pnpm test && pnpm build",
    "check:unused": "pnpm --filter @stem/desktop check:unused && pnpm --filter @stem/core check:unused && pnpm --filter @stem/cli check:unused",
    "build": "pnpm --filter @stem/desktop build && pnpm --filter @stem/cli build",
    "pack:mac": "pnpm --filter @stem/desktop package:mac",
    "test:containment": "pnpm --filter @stem/desktop build && pnpm --filter @stem/desktop exec playwright test tests/e2e/note-root-containment.spec.ts",
    "test:packaged:containment": "pnpm --filter @stem/desktop test:packaged:containment",
    "dist:mac": "pnpm --filter @stem/desktop dist:mac",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/install-local.test.mjs apps/desktop/scripts/electron-runtime.test.mjs apps/desktop/scripts/pack-mac.test.mjs && pnpm --dir packages/core test && pnpm --dir apps/desktop test && pnpm --dir packages/cli test",
    "test:e2e": "pnpm build && playwright test -c apps/desktop/playwright.config.ts",
    "test:visual": "pnpm --filter @stem/desktop build && playwright test -c apps/desktop/playwright.visual.config.ts",
    "graph:eval:test": "pnpm --filter @stem/graph-eval test",
    "graph:eval:smoke": "pnpm --filter @stem/graph-eval smoke",
    "graph:eval:standard": "pnpm --filter @stem/graph-eval standard",
    "graph:eval:mobile": "pnpm --filter @stem/graph-eval mobile",
    "graph:eval:resilience": "pnpm --filter @stem/graph-eval resilience",
    "graph:eval:incremental": "pnpm --filter @stem/graph-eval incremental",
    "graph:presentation:measure": "pnpm --filter @stem/desktop exec vitest run src/renderer/src/graphCanvasPerformance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "graph:presentation:perf": "STEM_GRAPH_PRESENTATION_PERF_GATE=1 pnpm --filter @stem/desktop exec vitest run src/renderer/src/graphCanvasPerformance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "rebuild:native": "pnpm --filter @stem/desktop rebuild:native",
    "postinstall": "pnpm --filter @stem/desktop setup:runtime && pnpm rebuild:native"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "0.27.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.14",
    "vitest": "4.1.0"
  }
}
